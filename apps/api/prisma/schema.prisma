datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  USER
}

enum WorkstreamStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum GoalStatus {
  PLANNED
  IN_PROGRESS
  ACHIEVED
  CANCELLED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  REACHED
  DELAYED
}

enum TaskStatus {
  BACKLOG
  READY
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  P0
  P1
  P2
  P3
}

enum TaskDependencyType {
  BLOCKS
  BLOCKED_BY
}

enum TimeBlockStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  INTERRUPTED
}

enum ReviewStatus {
  DRAFT
  COMPLETED
}

enum PlanHorizon {
  YEARLY
  MONTHLY
  WEEKLY
  DAILY
}

enum PlanOutcomeState {
  PLANNED
  IN_PROGRESS
  COMPLETED
  PARTIALLY_COMPLETED
  MISSED
  CANCELLED
  RESCHEDULED
  BLOCKED
  UNKNOWN
}

enum OutcomeVerificationState {
  PLANNED
  OBSERVED
  VERIFIED
}

enum ResultSource {
  AUTOMATIC
  USER_CONFIRMED
  SYSTEM_VERIFIED
  UNKNOWN
}

// ── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  displayName  String
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings      UserSettings?
  sessions      Session[]
  workstreams   Workstream[]
  goals         Goal[]
  projects      Project[]
  milestones    Milestone[]
  tasks         Task[]
  tags          Tag[]
  dailyPlans    DailyPlan[]
  timeBlocks    TimeBlock[]
  weeklyPlans   WeeklyPlan[]
  weeklyReviews WeeklyReview[]
  yearPlans     YearPlan[]
  monthPlans    MonthPlan[]
  planOutcomes  PlanOutcome[]
  planResultSnapshots PlanResultSnapshot[]
  resultExportLogs    ResultExportLog[]
  auditLogs     AuditLog[]
  skills        Skill[]
  learningItems LearningItem[]
  learningActivities LearningActivity[]
  evidence      Evidence[]
  opportunities Opportunity[]
  opportunityActivities OpportunityActivity[]
  conversations Conversation[]
  conversationMessages ConversationMessage[]
  userMemories UserMemory[]
}

model UserSettings {
  id                        String       @id @default(uuid())
  userId                    String       @unique
  user                      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone                  String       @default("UTC")
  weekStartsOn              Int          @default(1)
  dailyWorkCapacityMinutes  Int          @default(480)
  weeklyWorkCapacityMinutes Int          @default(2400)
  defaultTaskPriority       TaskPriority @default(P2)
  defaultProjectView        String       @default("board")
  theme                     String       @default("dark")
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
}

model Workstream {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  status         WorkstreamStatus @default(ACTIVE)
  priorityWeight Int              @default(1)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  goals        Goal[]
  projects     Project[]
  yearPlans    YearPlan[]
  monthPlans   MonthPlan[]
  weeklyPlans  WeeklyPlan[]
  planOutcomes PlanOutcome[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([userId, sortOrder])
}

model Goal {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workstreamId String
  workstream   Workstream   @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       GoalStatus   @default(PLANNED)
  priority     TaskPriority @default(P1)
  startDate    DateTime?
  targetDate   DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  projects     Project[]
  yearPlans    YearPlan[]
  monthPlans   MonthPlan[]
  weeklyPlans  WeeklyPlan[]
  planOutcomes PlanOutcome[]

  @@index([workstreamId, status])
  @@index([userId, targetDate])
}

model Project {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workstreamId String
  workstream   Workstream    @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  goalId       String?
  goal         Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  name         String
  slug         String
  description  String?
  status       ProjectStatus @default(PLANNED)
  priority     TaskPriority  @default(P2)
  startDate    DateTime?
  targetDate   DateTime?
  completedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  milestones       Milestone[]
  tasks            Task[]
  learningItems    LearningItem[]
  evidence         EvidenceProject[]
  opportunityLinks OpportunityProject[]
  yearPlans        YearPlan[]
  monthPlans       MonthPlan[]
  weeklyPlans      WeeklyPlan[]
  planOutcomes     PlanOutcome[]

  @@unique([userId, slug])
  @@index([workstreamId, status])
  @@index([goalId])
  @@index([userId, targetDate])
}

model Milestone {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      MilestoneStatus @default(UPCOMING)
  sortOrder   Int             @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tasks        Task[]
  planOutcomes PlanOutcome[]

  @@index([projectId, sortOrder])
  @@index([projectId, targetDate])
}

model Task {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parentTaskId    String?
  parentTask      Task?        @relation("TaskToSubtask", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks        Task[]       @relation("TaskToSubtask")
  title           String
  description     String?
  status          TaskStatus   @default(BACKLOG)
  priority        TaskPriority @default(P2)
  estimateMinutes Int          @default(0)
  actualMinutes   Int          @default(0)
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  blockingDependencies  TaskDependency[] @relation("BlockingTask")
  dependentDependencies TaskDependency[] @relation("DependentTask")
  tags                  TaskTag[]
  mustWinDailyPlans     DailyPlan[]      @relation("MustWinTask")
  timeBlocks            TimeBlock[]
  evidence              EvidenceTask[]
  opportunityLinks      OpportunityTask[]
  planOutcomes          PlanOutcome[]

  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([projectId, priority])
  @@index([milestoneId, status])
  @@index([parentTaskId])
}

model TaskDependency {
  id              String             @id @default(uuid())
  blockingTaskId  String
  blockingTask    Task               @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)
  dependentTaskId String
  dependentTask   Task               @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  dependencyType  TaskDependencyType @default(BLOCKS)
  createdAt       DateTime           @default(now())

  @@unique([blockingTaskId, dependentTaskId])
  @@index([blockingTaskId])
  @@index([dependentTaskId])
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  color     String   @default("#06b6d4")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks TaskTag[]

  @@unique([userId, slug])
  @@index([userId])
}

model TaskTag {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
}

model YearPlan {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  year             Int
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime
  status           String       @default("ACTIVE")
  priority         TaskPriority @default(P1)
  expectedOutcomes String?
  actualOutcomes   String?
  notes            String?
  workstreamId     String?
  workstream       Workstream?  @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  goalId           String?
  goal             Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  monthPlans   MonthPlan[]
  planOutcomes PlanOutcome[]

  @@unique([userId, year])
  @@index([userId, year])
  @@index([workstreamId])
  @@index([goalId])
  @@index([projectId])
}

model MonthPlan {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  yearPlanId       String?
  yearPlan         YearPlan?    @relation(fields: [yearPlanId], references: [id], onDelete: SetNull)
  year             Int
  month            Int
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime
  status           String       @default("ACTIVE")
  priority         TaskPriority @default(P1)
  expectedOutcomes String?
  actualOutcomes   String?
  notes            String?
  workstreamId     String?
  workstream       Workstream?  @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  goalId           String?
  goal             Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  weeklyPlans  WeeklyPlan[]
  planOutcomes PlanOutcome[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@index([yearPlanId])
  @@index([workstreamId])
  @@index([goalId])
  @@index([projectId])
}

model DailyPlan {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlanId     String?
  weeklyPlan       WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)
  date             DateTime
  primaryObjective String?
  mustWinTaskId   String?
  mustWinTask      Task?       @relation("MustWinTask", fields: [mustWinTaskId], references: [id], onDelete: SetNull)
  expectedOutcomes String?
  actualOutcomes   String?
  notes            String?
  status           String      @default("active")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  timeBlocks   TimeBlock[]
  planOutcomes PlanOutcome[]

  @@unique([userId, date])
  @@index([userId, date])
  @@index([weeklyPlanId])
}

model TimeBlock {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlanId String?
  dailyPlan   DailyPlan?      @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  taskId      String?
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title       String
  startAt     DateTime
  endAt       DateTime
  status      TimeBlockStatus @default(PLANNED)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, startAt])
  @@index([taskId, startAt])
  @@index([dailyPlanId])
}

model WeeklyPlan {
  id                     String      @id @default(uuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthPlanId            String?
  monthPlan              MonthPlan?  @relation(fields: [monthPlanId], references: [id], onDelete: SetNull)
  workstreamId           String?
  workstream             Workstream? @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  goalId                 String?
  goal                   Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectId              String?
  project                Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  weekStart              DateTime
  weekEnd                DateTime
  theme                  String?
  expectedOutcomes       String?
  actualOutcomes         String?
  capacityMinutes        Int         @default(2400)
  plannedWorkloadMinutes Int         @default(0)
  notes                  String?
  status                 String      @default("active")
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  dailyPlans    DailyPlan[]
  weeklyReviews WeeklyReview[]
  planOutcomes  PlanOutcome[]

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
  @@index([monthPlanId])
  @@index([workstreamId])
  @@index([goalId])
  @@index([projectId])
}

model WeeklyReview {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlanId String?
  weeklyPlan   WeeklyPlan?  @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)
  status       ReviewStatus @default(DRAFT)
  wins         String?
  challenges   String?
  lessons      String?
  nextFocus    String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([weeklyPlanId])
}

model PlanOutcome {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  horizon            PlanHorizon
  yearPlanId         String?
  yearPlan           YearPlan?        @relation(fields: [yearPlanId], references: [id], onDelete: Cascade)
  monthPlanId        String?
  monthPlan          MonthPlan?       @relation(fields: [monthPlanId], references: [id], onDelete: Cascade)
  weeklyPlanId       String?
  weeklyPlan         WeeklyPlan?      @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  dailyPlanId        String?
  dailyPlan          DailyPlan?       @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  workstreamId       String?
  workstream         Workstream?      @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  goalId             String?
  goal               Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectId          String?
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestoneId        String?
  milestone          Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  taskId             String?
  task               Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  startDate          DateTime?
  endDate            DateTime?
  plannedMinutes     Int?
  priority           TaskPriority     @default(P2)
  expectedResult     String?
  actualResult       String?
  outcomeState       PlanOutcomeState @default(PLANNED)
  source             ResultSource     @default(AUTOMATIC)
  isUserConfirmed    Boolean          @default(false)
  userExplanation    String?
  rescheduledTo      DateTime?
  carriedForwardToId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  evidenceLinks PlanOutcomeEvidence[]

  @@index([userId, horizon])
  @@index([dailyPlanId])
  @@index([weeklyPlanId])
  @@index([monthPlanId])
  @@index([yearPlanId])
  @@index([taskId])
  @@index([projectId])
  @@index([goalId])
  @@index([workstreamId])
  @@index([outcomeState])
}

model PlanOutcomeEvidence {
  id                String                   @id @default(uuid())
  planOutcomeId     String
  planOutcome       PlanOutcome              @relation(fields: [planOutcomeId], references: [id], onDelete: Cascade)
  evidenceId        String
  evidence          Evidence                 @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  verificationState OutcomeVerificationState @default(OBSERVED)
  createdAt         DateTime                 @default(now())

  @@unique([planOutcomeId, evidenceId])
  @@index([planOutcomeId])
  @@index([evidenceId])
}

model PlanResultSnapshot {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  horizon          PlanHorizon
  periodKey        String
  summaryText      String?
  totalPlanned     Int         @default(0)
  totalCompleted   Int         @default(0)
  totalPartial     Int         @default(0)
  totalMissed      Int         @default(0)
  totalBlocked     Int         @default(0)
  totalRescheduled Int         @default(0)
  totalCancelled   Int         @default(0)
  snapshotData     Json?
  createdAt        DateTime    @default(now())

  @@unique([userId, horizon, periodKey])
  @@index([userId, horizon])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  userAgent  String?
  ipAddress  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([tokenHash])
}

// ── Learning & Skills Intelligence Enums & Models ─────────────────────────────

enum LearningItemType {
  COURSE
  BOOK
  TUTORIAL
  DOCUMENTATION
  LECTURE
  PROJECT
  PRACTICE
  ARTICLE
  OTHER
}

enum LearningItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

enum SkillLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillStatus {
  ACTIVE
  PAUSED
  MASTERED
  ARCHIVED
}

enum SkillRelevance {
  PRIMARY
  SECONDARY
}

model Skill {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String?
  category     String?
  currentLevel SkillLevel  @default(BEGINNER)
  targetLevel  SkillLevel  @default(ADVANCED)
  status       SkillStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  learningItems LearningItemSkill[]
  evidence      EvidenceSkill[]
  opportunityLinks OpportunitySkill[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([userId, category])
}

model LearningItem {
  id               String             @id @default(uuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  type             LearningItemType   @default(COURSE)
  status           LearningItemStatus @default(NOT_STARTED)
  source           String?
  url              String?
  estimatedMinutes Int                @default(0)
  progressPercent  Int                @default(0)
  startedAt        DateTime?
  targetDate       DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  activities LearningActivity[]
  skills     LearningItemSkill[]
  evidence   EvidenceLearningItem[]

  @@index([userId, status])
  @@index([userId, targetDate])
  @@index([projectId])
}

model LearningActivity {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningItemId String
  learningItem   LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  minutes        Int
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([learningItemId])
  @@index([userId, date])
}

model LearningItemSkill {
  id             String         @id @default(uuid())
  learningItemId String
  learningItem   LearningItem   @relation(fields: [learningItemId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  relevance      SkillRelevance @default(PRIMARY)
  createdAt      DateTime       @default(now())

  @@unique([learningItemId, skillId])
  @@index([learningItemId])
  @@index([skillId])
}

// ── Evidence Engine Enums & Models ───────────────────────────────────────────

enum EvidenceType {
  GITHUB_REPOSITORY
  GIT_COMMIT
  DEPLOYMENT
  PROJECT
  DOCUMENT
  SCREENSHOT
  VIDEO
  CERTIFICATE
  ASSIGNMENT
  EXAM_RESULT
  PRESENTATION
  ARTICLE
  CLIENT_DELIVERY
  PROTOTYPE
  RESEARCH_RESULT
  OTHER
}

model Evidence {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  type              EvidenceType @default(PROJECT)
  url               String?
  externalReference String?
  date              DateTime     @default(now())
  verified          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  tasks         EvidenceTask[]
  projects      EvidenceProject[]
  learningItems EvidenceLearningItem[]
  skills        EvidenceSkill[]
  opportunityLinks OpportunityEvidence[]
  planOutcomeLinks PlanOutcomeEvidence[]

  @@index([userId, date])
  @@index([userId, type])
}

model EvidenceTask {
  id         String   @id @default(uuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([evidenceId, taskId])
  @@index([evidenceId])
  @@index([taskId])
}

model EvidenceProject {
  id         String   @id @default(uuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([evidenceId, projectId])
  @@index([evidenceId])
  @@index([projectId])
}

model EvidenceLearningItem {
  id             String       @id @default(uuid())
  evidenceId     String
  evidence       Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  learningItemId String
  learningItem   LearningItem @relation(fields: [learningItemId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([evidenceId, learningItemId])
  @@index([evidenceId])
  @@index([learningItemId])
}

model EvidenceSkill {
  id         String   @id @default(uuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([evidenceId, skillId])
  @@index([evidenceId])
  @@index([skillId])
}

// ── Opportunities & Career Execution Engine ──────────────────────────────────

enum OpportunityType {
  FREELANCE
  INTERNSHIP
  FULL_TIME
  PART_TIME
  CONTRACT
  CLIENT
  RESEARCH
  COLLABORATION
  ENTREPRENEURIAL
  COMPETITION
  SCHOLARSHIP
  EVENT
  OTHER
}

enum OpportunityStatus {
  DISCOVERED
  EVALUATING
  PREPARING
  APPLIED
  IN_DISCUSSION
  INTERVIEW
  OFFERED
  ACCEPTED
  ACTIVE
  COMPLETED
  REJECTED
  WITHDRAWN
  EXPIRED
  ARCHIVED
}

enum OpportunitySource {
  DIRECT_CONTACT
  COMPANY_WEBSITE
  LINKEDIN
  UPWORK
  REFERRAL
  UNIVERSITY
  YOMTECH
  PERSONAL_NETWORK
  EMAIL
  EVENT
  OTHER
}

enum OpportunityActivityType {
  NOTE
  CONTACT
  APPLICATION_SUBMITTED
  INTERVIEW
  FOLLOW_UP
  OFFER
  STATUS_CHANGE
  OTHER
}

model Opportunity {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  type             OpportunityType   @default(FULL_TIME)
  status           OpportunityStatus @default(DISCOVERED)
  priority         TaskPriority      @default(P2)
  organizationName String?
  contactName      String?
  contactEmail     String?
  source           OpportunitySource @default(OTHER)
  sourceUrl        String?
  location         String?
  remote           Boolean           @default(false)
  estimatedValue   Decimal?          @db.Decimal(12, 2)
  currency         String            @default("USD")
  startDate        DateTime?
  deadline         DateTime?
  followUpDate     DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  closedAt         DateTime?

  skills     OpportunitySkill[]
  projects   OpportunityProject[]
  evidence   OpportunityEvidence[]
  tasks      OpportunityTask[]
  activities OpportunityActivity[]

  @@index([userId, status])
  @@index([userId, type])
  @@index([userId, priority])
  @@index([userId, deadline])
  @@index([userId, followUpDate])
}

model OpportunitySkill {
  id            String         @id @default(uuid())
  opportunityId String
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  relevance     SkillRelevance @default(PRIMARY)
  createdAt     DateTime       @default(now())

  @@unique([opportunityId, skillId])
  @@index([opportunityId])
  @@index([skillId])
}

model OpportunityProject {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, projectId])
  @@index([opportunityId])
  @@index([projectId])
}

model OpportunityEvidence {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  evidenceId    String
  evidence      Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, evidenceId])
  @@index([opportunityId])
  @@index([evidenceId])
}

model OpportunityTask {
  id            String      @id @default(uuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([opportunityId, taskId])
  @@index([opportunityId])
  @@index([taskId])
}

model OpportunityActivity {
  id            String                  @id @default(uuid())
  opportunityId String
  opportunity   Opportunity             @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId        String
  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          OpportunityActivityType @default(NOTE)
  title         String
  description   String?
  occurredAt    DateTime                @default(now())
  createdAt     DateTime                @default(now())

  @@index([opportunityId, occurredAt])
  @@index([userId, occurredAt])
}

// ── Intelligence Core Enums & Models ──────────────────────────────────────────

enum MemoryCategory {
  PREFERENCE
  WORKFLOW
  GOAL_CONTEXT
  PROJECT_CONTEXT
  LEARNING_PREFERENCE
  COMMUNICATION_PREFERENCE
  OTHER
}

model Conversation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("New Conversation")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  archivedAt DateTime?

  messages ConversationMessage[]

  @@index([userId, updatedAt])
  @@index([userId, archivedAt])
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       // USER, ASSISTANT, SYSTEM, TOOL
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model UserMemory {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  value      String
  category   MemoryCategory @default(OTHER)
  source     String         @default("USER_CONFIRMED")
  confidence Float          @default(1.0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  archivedAt DateTime?

  @@unique([userId, key])
  @@index([userId, category])
  @@index([userId, archivedAt])
}

model ResultExportLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       String   // current, day, week, month, year, custom, full
  format      String   // XLSX, JSON
  rangeFrom   String?
  rangeTo     String?
  recordCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}





