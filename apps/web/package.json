{
  "name": "@kenenisa-os/web",
  "version": "0.1.0",
  "description": "KENENISA OS — React Frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
