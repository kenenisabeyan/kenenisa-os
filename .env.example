# ============================================================
# KENENISA OS — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Environment & Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kenenisa_os?schema=public

# Security & Session
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production
RATE_LIMIT_MAX=100

# AI Intelligence Core (Optional — Falls back to MockAIProvider if unconfigured)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=your_openai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000

# Frontend Web Application (Vite Environment Variables)
VITE_API_URL=http://localhost:3000
